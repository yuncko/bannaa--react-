# مفاتيح مزوّد Omnirouter — مطلوبة
# انسخ هذا الملف إلى .env.local واملأ القيم. لا تُرفع هذه القيم إلى Git.
# Omnirouter provider keys (required). Copy to .env.local and fill in.
# Failover order: KEY_1 -> KEY_2 -> KEY_3. At least one is required.
OMNIROUTER_API_KEY_1=
OMNIROUTER_API_KEY_2=
OMNIROUTER_API_KEY_3=

# اختياري: لتجاوز عنوان المزوّد الافتراضي https://omnirouter.li/v1
# Optional: override the default provider base URL.
# OMNIROUTER_BASE_URL=

# ── Supabase (تسجيل الدخول) — اختياري ──────────────────────────────────────────
# Supabase auth. Optional: without these the app still generates projects, the
# auth screens explain what is missing, and the proxy skips session handling.
# Both values below are safe to expose to the browser — row level security is
# what protects data. Never put the service_role key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys. Either a new `sb_publishable_…` key or a legacy
# JWT anon key works; NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted as an alias.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# اختياري: العنوان المطلق للموقع، يُستخدم لبناء روابط OAuth والبريد.
# Optional, recommended in production: absolute site origin used to build OAuth
# and email redirect URLs. Falls back to the forwarded Host header.
# NEXT_PUBLIC_SITE_URL=
